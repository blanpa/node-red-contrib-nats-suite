{
  "name": "node-red-contrib-nats-suite",
  "version": "0.3.0",
  "description": "A comprehensive Node-RED module for NATS (Core, JetStream, KV, Object Store, Service API) – generic NATS integration for Node-RED.",
  "keywords": [
    "node-red",
    "nats",
    "nats-io",
    "messaging",
    "pubsub",
    "jetstream",
    "kv",
    "object-store"
  ],
  "files": [
    "nodes/",
    "lib/",
    "examples/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "nats-suite-server": "nodes/nats-suite-server.js",
      "nats-suite-server-pool": "nodes/nats-suite-server-pool.js",
      "nats-suite-publish": "nodes/nats-suite-publish.js",
      "nats-suite-subscribe": "nodes/nats-suite-subscribe.js",
      "nats-suite-stream-publisher": "nodes/nats-suite-stream-publisher.js",
      "nats-suite-stream-consumer": "nodes/nats-suite-stream-consumer.js",
      "nats-suite-kv-get": "nodes/nats-suite-kv-get.js",
      "nats-suite-kv-put": "nodes/nats-suite-kv-put.js",
      "nats-suite-server-manager": "nodes/nats-suite-server-manager.js",
      "nats-suite-object-get": "nodes/nats-suite-object-get.js",
      "nats-suite-object-put": "nodes/nats-suite-object-put.js",
      "nats-suite-service": "nodes/nats-suite-service.js"
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:watch": "node --test --watch --test-concurrency=1 \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "blanpa",
  "contributors": [
    {
      "name": "blanpa"
    },
    {
      "name": "dbleul"
    },
    {
      "name": "Paul Deng",
      "url": "https://github.com/pauldeng"
    }
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/kv": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "@nats-io/obj": "3.4.0",
    "@nats-io/services": "3.4.0",
    "@nats-io/transport-node": "3.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blanpa/node-red-contrib-nats-suite.git"
  },
  "homepage": "https://github.com/blanpa/node-red-contrib-nats-suite#readme",
  "bugs": {
    "url": "https://github.com/blanpa/node-red-contrib-nats-suite/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
